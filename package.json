{
  "name": "angular-lab",
  "version": "0.0.0",
  "scripts": {
    "start": "concurrently -n shell,finance,banking -c green,blue,magenta \"ng serve shell\" \"ng serve finance-shell\" \"ng serve finance-banking\"",
    "build": "ng build shell && ng build finance-shell && ng build finance-banking",
    "test": "npm run test:domain && ng test shell --watch=false && ng test finance-banking --watch=false",
    "test:domain": "vitest run --config vitest.domain.config.ts",
    "lint:arch": "sheriff verify",
    "ng": "ng"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular-architects/native-federation": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "es-module-shims": "^2.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@softarc/native-federation-orchestrator": "^4.8.0",
    "@softarc/sheriff-core": "^0.20.0",
    "concurrently": "^9.2.5",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
